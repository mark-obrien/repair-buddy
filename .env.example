# --- Required: at least one AI provider key ---

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI — required for GPT-4o models AND Whisper speech-to-text fallback
OPENAI_API_KEY=sk-your-key-here

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your-key-here

# --- Optional: transcript caching ---
REDIS_URL=redis://localhost:6379

# --- Optional: YouTube comments mining ---
# When set, the top viewer comments are fetched and used as additional context
# during guide generation — they often contain corrections or model-year notes
# the presenter missed. Get a key at https://console.cloud.google.com/ (enable
# YouTube Data API v3, then create an API key). Free tier is generous.
YOUTUBE_API_KEY=

# --- Optional: override ffmpeg binary path (e.g. for custom server deployments) ---
# FFMPEG_PATH=/usr/bin/ffmpeg
